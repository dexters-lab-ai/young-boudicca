# Ignore VCS
.git
.gitignore

# Node and build artifacts
node_modules
dist
build
.env
.env.* 

# Local dev virtualenvs
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd

# OS files
.DS_Store
Thumbs.db

# Logs and temp
*.log
tmp/
temp/

# Large ML model files — keep out of build context (we download them in the Dockerfile)
*.onnx
*.bin
/app/models
models/

# Ignore editor files
.vscode
.idea

# Do NOT ignore server/python-tts or .py files — ensure kokoro_server.py is included
# (explicitly allow python-tts by leaving it out of patterns above)