# Production Environment Variables
NODE_ENV=production
NODE_OPTIONS=--max_old_space_size=4096
NPM_CONFIG_PRODUCTION=false
SERVER_PORT=8787
VITE_PORT=3000

# Server Configuration
HOST=0.0.0.0

# Kokoro TTS Service
KOKORO_SERVICE_URL=http://127.0.0.1:8899
AUTO_START_KOKORO_SERVICE=true
KOKORO_MODEL_PATH=/app/server/python-tts/models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=/app/server/python-tts/models/voices-v1.0.bin
KOKORO_CACHE_DIR=/tmp/kokoro-cache

# Performance Tuning
KOKORO_THREADS=4  # Adjust based on available CPU cores
KOKORO_USE_GPU=false  # Set to true if GPU is available

