{
  "name": "ai-dreams",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config tsconfig.node.json",
    "build:type-check": "tsc --noEmit --skipLibCheck",
    "build:prod": "vite build --mode production --config tsconfig.node.json",
    "preview": "vite preview --port 3000",
    "start": "node --import tsx server/index.ts",
    "start:pm2": "pm2-runtime start ecosystem.config.cjs",
    "server": "tsx server/index.ts",
    "worker": "tsx server/worker.ts",
    "dev:all": "concurrently \"npm run server\" \"npm run worker\" \"npm run dev\"",
    "type-check": "tsc --noEmit --skipLibCheck",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "prepare": "npm run build",
    "test": "vitest",
    "test:watch": "vitest watch"
  },
